                {
                  "kind": "unknown"
                },
                {
                  "kind": "absent"
                },
                {
                  "kind": "literal",
                  "text": "[source](https://invalid.example) & null"
                }
              ],
              "matches": [],
              "explanation": "No matches and no winner; show the explicit unmatched result. Nothing is fetched or evaluated. <inactive-case> </script>",
              "references": ["Literal </script><script>not executable</script> reference"]

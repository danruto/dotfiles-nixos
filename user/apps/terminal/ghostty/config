# Colors come from the runtime theme file below (scripts/theme-render).
config-file = ?~/.local/state/theme/current/ghostty
font-family = D2KodingLigature Nerd Font
font-size = 14
background-opacity = 1.0
window-decoration = "none"
background-blur = true
# Tabs/titlebar follow the palette instead of the stuck libadwaita scheme.
window-theme = ghostty

macos-option-as-alt = left
keybind = alt+left=unbind
keybind = alt+right=unbind

{ lib, stdenvNoCC, buildNpmPackage, fetchFromGitHub, fetchurl, makeBinaryWrapper, jq
, versionCheckHook, writableTmpDirAsHomeHook, nodejs, ripgrep, fd, python3 }:

# Own derivation instead of overriding nixpkgs' pi-coding-agent: nixpkgs-master
# lags upstream releases, and its install script hardcodes the workspace list,
# which breaks whenever upstream adds or drops a package.
# To bump: scripts/bump pi
buildNpmPackage (finalAttrs: {
  pname = "pi-coding-agent";
  version = "1.3.0";

  src = fetchFromGitHub {
    owner = "earendil-works";
    repo = "pi";
    tag = "v${finalAttrs.version}";
    hash = "sha256-AsutbwnjiwwLkB5tqLW+1GdGZyLmXsU0W+SNdNhJu7U=";
  };

  npmDepsHash = "sha256-+gFyvrhkCsF99oNvs0gBmLXnDW0hWnZI/wFId7UbI6Q=";

  # The provider model catalog is generated by a network fetch and gitignored
  # upstream; restore it from the matching published @earendil-works/pi-ai.
  modelData = fetchurl {
    url = "https://registry.npmjs.org/@earendil-works/pi-ai/-/pi-ai-${finalAttrs.version}.tgz";
    hash = "sha512-KaBI8x7q7sPoFUXICNGD9efHzDG+oRNwVvkA9jdIsSQWH1RjFssOlEGsbLtewUPPgCrvmz0l2KTgSLXTyj3acw==";
  };

  preConfigure = ''
    mkdir -p packages/ai/src/providers/data
    tar --extract --gzip --file=${finalAttrs.modelData} \
      --directory=packages/ai/src/providers/data \
      --strip-components=4 \
      package/dist/providers/data
  '';

  npmWorkspace = "packages/coding-agent";
  npmRebuildFlags = [ "--ignore-scripts" ];
  nativeBuildInputs = [ makeBinaryWrapper jq ];

  buildPhase = ''
    runHook preBuild
    npm run build:offline
    runHook postBuild
  '';

  dontNpmPrune = true;
  preInstall = ''
    npm prune --omit=dev --no-save
  '';

  # Workspace symlinks in the output point into packages/, which isn't copied.
  # Replace coding-agent's transitive @earendil-works workspace deps with real
  # copies (resolved from package.json, so new/dropped packages need no edit),
  # then delete the remaining links.
  postInstall = ''
    local nm="$out/lib/node_modules/pi-monorepo/node_modules"
    local map
    map=$(jq -rn '[inputs | {(.name): input_filename}] | add' packages/*/package.json)

    local -A seen=()
    local queue=(packages/coding-agent/package.json) pj pj_dep dep dir
    while [ ''${#queue[@]} -gt 0 ]; do
      pj=''${queue[0]}; queue=("''${queue[@]:1}")
      for dep in $(jq -r '.dependencies // {} | keys[] | select(startswith("@earendil-works/"))' "$pj"); do
        [ -n "''${seen[$dep]:-}" ] && continue
        seen[$dep]=1
        pj_dep=$(jq -er --arg d "$dep" '.[$d]' <<<"$map")
        dir=$(dirname "$pj_dep")
        rm -f "$nm/$dep"
        cp -r "$dir" "$nm/$dep"
        queue+=("$pj_dep")
      done
    done

    find "$nm" -type l -lname '*/packages/*' -delete
    find "$nm/.bin" -xtype l -delete
  ''
  + lib.optionalString stdenvNoCC.hostPlatform.isDarwin ''
    rm -rf \
      "$nm/@anthropic-ai/sandbox-runtime/dist/vendor/seccomp" \
      "$nm/@anthropic-ai/sandbox-runtime/vendor/seccomp"
  '';

  # pi spawns `npm install` at runtime for package extensions and compiles
  # native npm modules (e.g. node-pty) when installing/updating them;
  # node-gyp needs python on PATH. Scoped to pi's wrapper instead of the
  # global profile (gcc/gnumake come from user/lang/cc).
  postFixup = ''
    wrapProgram $out/bin/pi \
      --prefix PATH : ${lib.makeBinPath [ nodejs ripgrep fd python3 ]} \
      --set-default PI_SKIP_VERSION_CHECK 1 \
      --set-default PI_TELEMETRY 0
  '';

  doInstallCheck = true;
  nativeInstallCheckInputs = [ writableTmpDirAsHomeHook versionCheckHook ];
  versionCheckKeepEnvironment = [ "HOME" ];
  versionCheckProgram = "${placeholder "out"}/bin/pi";
  versionCheckProgramArg = "--version";

  meta = {
    description = "Coding agent CLI with read, bash, edit, write tools and session management";
    homepage = "https://pi.dev/";
    license = lib.licenses.mit;
    mainProgram = "pi";
  };
})

{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "alwaysThinkingEnabled": true,
  "attributionEnabled": false,
  "attributionName": "",
  "autoMemoryEnabled": false,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(oxlint:*)",
      "Bash(oxfmt:*)",
      "Bash(pbtk graph:*)",
      "Bash(pbtk doc:*)",
      "Bash(gh pr view:*)"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(just deploy-local:*)",
      "Bash(pulumi up:*)",
      "Bash(pulumi destroy:*)"
    ]
  },
  "disableArtifact": true,
  "disableBundledSkills": true,
  "disableWorkflows": true,
  "effortLevel": "high",
  "enabledPlugins": {
    "bb@bubblebeam": true,
    "claude-code-setup@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "pb@pb-skills": true,
    "ponytail@ponytail": true,
    "revdiff@revdiff": true,
    "runpod@runpod": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "bubblebeam": {
      "source": {
        "path": "/home/danruto/dev/nearmap/bubblebeam",
        "source": "directory"
      }
    },
    "ponytail": {
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    },
    "runpod": {
      "source": {
        "repo": "runpod/runpod-plugins-official",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "jq -cr '# pbtk-prehook-v3\n{hookSpecificOutput:{hookEventName:\"PreToolUse\",updatedInput:(.tool_input + {command:\n  (\"pbtk exec --shell -- \" + (.tool_input.command | @sh))})}}'",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/home/danruto/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "model": "opus[1m]",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(npm test:*)",
      "Bash(yarn test:*)",
      "Bash(bun test:*)",
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(make:*)",
      "Bash(just:*)",
      "Read(*.env.llm)",
      "Read(*.envrc)",
      "mcp__fff__grep",
      "mcp__fff__find_files",
      "mcp__fff__multi_grep"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(but push:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(sudo:*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.staging)",
      "Read(.env.test)",
      "ExitPlanMode",
      "EnterPlanMode",
      "DesignSync",
      "PushNotification"
    ]
  },
  "remoteControlAtStartup": false,
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 30,
    "type": "command"
  },
  "subagentStatusLine": {
    "command": "~/.claude/subagent-statusline.sh",
    "type": "command"
  },
  "theme": "auto",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true
}

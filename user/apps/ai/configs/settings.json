{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "alwaysThinkingEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoMemoryEnabled": false,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(oxlint:*)",
      "Bash(oxfmt:*)",
      "Bash(gh pr view:*)"
    ],
    "soft_deny": [
      "$defaults"
    ]
  },
  "disableBundledSkills": true,
  "disableWorkflows": true,
  "effortLevel": "high",
  "enableArtifact": true,
  "enabledPlugins": {
    "bb@bubblebeam": true,
    "claude-code-setup@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "revdiff@revdiff": true,
    "runpod@runpod": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_SHELL_PREFIX": "/home/danruto/dotfiles-nixos/user/apps/ai/configs/kill-guard.sh",
    "CURL_CA_BUNDLE": "/run/user/1000/aproxy/ca-bundle.pem",
    "HTTPS_PROXY": "http://127.0.0.1:14500",
    "NODE_EXTRA_CA_CERTS": "/run/user/1000/aproxy/ca.pem",
    "NODE_USE_ENV_PROXY": "1",
    "NO_PROXY": "localhost,127.0.0.1,::1,.anthropic.com,claude.ai",
    "REQUESTS_CA_BUNDLE": "/run/user/1000/aproxy/ca-bundle.pem",
    "SSL_CERT_FILE": "/run/user/1000/aproxy/ca-bundle.pem",
    "https_proxy": "http://127.0.0.1:14500",
    "no_proxy": "localhost,127.0.0.1,::1,.anthropic.com,claude.ai"
  },
  "extraKnownMarketplaces": {
    "bubblebeam": {
      "source": {
        "path": "/home/danruto/dev/nearmap/bubblebeam",
        "source": "directory"
      }
    },
    "runpod": {
      "source": {
        "repo": "runpod/runpod-plugins-official",
        "source": "github"
      }
    }
  },
  "feedbackDrafts": "off",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/home/danruto/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash '/home/danruto/dotfiles-nixos/user/apps/ai/configs/vcs-mode.sh'",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^(startup|resume|clear|compact|fork)$"
      }
    ]
  },
  "model": "opus",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(npm test:*)",
      "Bash(yarn test:*)",
      "Bash(bun test:*)",
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(make:*)",
      "Bash(just:*)",
      "Read(*.env.llm)",
      "Read(*.envrc)",
      "mcp__fff__grep",
      "mcp__fff__find_files",
      "mcp__fff__multi_grep"
    ],
    "ask": [
      "Bash(but push:*)",
      "Bash(gh pr create:*)",
      "Bash(git push:*)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git reset --hard:*)",
      "Bash(sudo:*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.staging)",
      "Read(.env.test)",
      "ExitPlanMode"
    ]
  },
  "remoteControlAtStartup": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 30,
    "type": "command"
  },
  "subagentStatusLine": {
    "command": "~/.claude/subagent-statusline.sh",
    "type": "command"
  },
  "switchModelsOnFlag": false,
  "theme": "auto",
  "tui": "fullscreen",
  "verbose": true,
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true
}

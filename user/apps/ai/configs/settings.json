{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(npm test:*)",
      "Bash(yarn test:*)",
      "Bash(bun test:*)",
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(make:*)",
      "Bash(just:*)",
      "Read(*.env.llm)",
      "Read(*.envrc)",
      "mcp__fff__grep",
      "mcp__fff__find_files",
      "mcp__fff__multi_grep"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git reset --hard:*)",
      "Bash(sudo:*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.staging)",
      "Read(.env.test)",
      "ExitPlanMode"
    ],
    "ask": [
      "Bash(but push:*)",
      "Bash(gh pr create:*)",
      "Bash(git push:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "disableBundledSkills": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/danruto/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash '/home/danruto/dotfiles-nixos/user/apps/ai/configs/vcs-mode.sh'",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "disableWorkflows": true,
  "enableArtifact": true,
  "subagentStatusLine": {
    "type": "command",
    "command": "~/.claude/subagent-statusline.sh"
  },
  "enabledPlugins": {
    "bb@bubblebeam": true,
    "claude-code-setup@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "revdiff@revdiff": true,
    "runpod@runpod": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "bubblebeam": {
      "source": {
        "source": "directory",
        "path": "/home/danruto/dev/nearmap/bubblebeam"
      }
    },
    "runpod": {
      "source": {
        "source": "github",
        "repo": "runpod/runpod-plugins-official"
      }
    }
  },
  "feedbackDrafts": "off",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "verbose": true,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": false,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(oxlint:*)",
      "Bash(oxfmt:*)",
      "Bash(gh pr view:*)"
    ],
    "soft_deny": [
      "$defaults"
    ]
  },
  "voiceEnabled": true
}

+func newMigratedNodeBusRig(t *testing.T) *busRig {
+	t.Helper()
+	rig := newBusRig(t, busSpec("node", "shared-ok", "node",
+		busListenerAt{"ch", "record+echo=removed"}, busListenerAt{"ch", "record"},
+		busListenerAt{"ack", "record"}, busListenerAt{"removed", "record"}))
+	rig.must("node", "emit", "ch json 0")
+	rig.expect(`node|ch|0`, `node|removed|{"by":"node","got":0}`, `node|ch|0`)
+	rig.reset()
+
+	spec := busSpec("go", "isolated", "migration-native", busListenerAt{"native", "record+echo=ack"})
+	spec.Log, spec.cwd = rig.log, rig.cwd
+	root := findModuleRoot(t)
+	cfg := busConfig(t, root, spec)
+	manifest := fmt.Sprintf("module %s\n\ngo 1.26\n\nrequire github.com/MichaelKinsy/PiG/extensions/sdk v0.0.0\n\nreplace github.com/MichaelKinsy/PiG/extensions/sdk => %s\n", cfg.ModulePath, strconv.Quote(filepath.Join(root, "extensions", "sdk")))
+	if err := os.WriteFile(filepath.Join(cfg.Source, "go.mod"), []byte(manifest), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	loaded, failures := rig.host.LoadAll(t.Context(), []subprocess.ExtConfig{cfg})
+	if len(failures) != 0 || len(loaded) != 1 {
+		t.Fatalf("late native load: loaded=%v failures=%v", loaded, failures)
+	}
+	rig.exts[loaded[0].Name] = loaded[0]
+	rig.configs = append(rig.configs, cfg)
+	rig.must("node", "emit", "native json 9")
+	rig.expect(`migration-native|native|9`, `node|ack|{"by":"migration-native","got":9}`)
+	rig.reset()
+	rig.must("node", "sub", "ch record")
+	return rig
+}
+
+func (r *busRig) reload() {
+	r.t.Helper()
+	loaded, err := r.host.Reload(r.t.Context())
+	if err != nil {
+		r.t.Fatal(err)
+	}
+	for _, ext := range loaded {
+		r.exts[ext.Name] = ext
+	}
 }
 

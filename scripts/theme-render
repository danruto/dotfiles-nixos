# herdr ---------------------------------------------------------------------
# herdr reads exactly one config file and writes settings back into it, so it
# has no include to point at a rendered palette. The theme therefore lives in a
# marker-delimited block inside the repo config; everything outside the markers
# is preserved. Every token that matters is overridden explicitly, because
# herdr's built-in themes hardcode dark foregrounds while leaving sidebar_bg at
# "reset" (the host terminal background) -- the combination that made the
# sidebar near-invisible under a light terminal theme. "terminal" is only the
# fallback base for tokens a future herdr version might add.
herdr_cfg="$REPO/user/apps/terminal/configs/herdr/config.toml"
if [ -f "$herdr_cfg" ]; then
  if grep -q '^# >>> herdr-theme' "$herdr_cfg"; then
    tmp="$(mktemp)"
    cat > "$tmp" <<'EOF'
# >>> herdr-theme (generated by scripts/theme-render; edit outside the markers)
[theme]
name = "terminal"
auto_switch = false

[theme.custom]
accent       = "#@@h0D@@"
panel_bg     = "#@@h00@@"
sidebar_bg   = "#@@h00@@"
active_row_bg = "#@@h02@@"
selection_bg = "#@@h03@@"
surface0     = "#@@h01@@"
surface1     = "#@@h02@@"
surface_dim  = "#@@h01@@"
overlay0     = "#@@h04@@"
overlay1     = "#@@h05@@"
text         = "#@@h05@@"
subtext0     = "#@@h04@@"
mauve        = "#@@h0E@@"
green        = "#@@h0B@@"
yellow       = "#@@h0A@@"
red          = "#@@h08@@"
blue         = "#@@h0D@@"
teal         = "#@@h0C@@"
peach        = "#@@h09@@"
# <<< herdr-theme
EOF
    subst "$tmp" "$tmp.out"
    block="$(cat "$tmp.out")"
    awk -v block="$block" '
      /^# >>> herdr-theme/ { print block; skip = 1; next }
      /^# <<< herdr-theme/ { skip = 0; next }
      !skip
    ' "$herdr_cfg" > "$herdr_cfg.tmp"
    mv "$herdr_cfg.tmp" "$herdr_cfg"
    rm -f "$tmp" "$tmp.out"
  else
    echo "  warning: no '# >>> herdr-theme' marker in config.toml; herdr theme not rendered" >&2
  fi
fi

# pi -------------------------------------------------------------------------
# pi loads custom themes from ~/.pi/agent/themes/*.json and hot-reloads the
# active one by watching that directory, so the rendered theme is written
# straight into it rather than symlinked in: a symlink swap to a different
# state dir would never produce an event on the watched directory.
# Token names are pi's; the assignments follow the canonical base16 mapping the
# other templates use (comment base03, keyword base0E, function base0D,
# string base0B, number base09, type base0A, diff plus/minus base0B/base08).
render pi-theme.json <<'EOF'
{
  "$schema": "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "base16",
  "colors": {
    "accent": "#@@h0D@@",
    "border": "#@@h03@@",
    "borderAccent": "#@@h0D@@",
    "borderMuted": "#@@h02@@",
    "success": "#@@h0B@@",
    "error": "#@@h08@@",
    "warning": "#@@h0A@@",
    "muted": "#@@h04@@",
    "dim": "#@@h03@@",
    "text": "#@@h05@@",
    "thinkingText": "#@@h04@@",
    "scrollbarTrack": "#@@h02@@",
    "scrollbarThumb": "#@@h03@@",

    "selectedBg": "#@@h02@@",
    "searchMatchBg": "#@@h02@@",
    "searchMatchText": "#@@h05@@",
    "userMessageBg": "#@@h01@@",
    "userMessageText": "#@@h05@@",
    "customMessageBg": "#@@h01@@",
    "customMessageText": "#@@h05@@",
    "customMessageLabel": "#@@h0E@@",
    "toolPendingBg": "#@@h01@@",
    "toolSuccessBg": "#@@piToolOkBg@@",
    "toolErrorBg": "#@@piToolErrBg@@",
    "toolTitle": "#@@h0D@@",
    "toolOutput": "#@@h05@@",

    "mdHeading": "#@@h0D@@",
    "mdLink": "#@@h0D@@",
    "mdLinkUrl": "#@@h04@@",
    "mdCode": "#@@h0C@@",
    "mdCodeBlock": "#@@h05@@",
    "mdCodeBlockBorder": "#@@h04@@",
    "mdQuote": "#@@h0C@@",
    "mdQuoteBorder": "#@@h04@@",
    "mdHr": "#@@h04@@",
    "mdListBullet": "#@@h0E@@",

    "toolDiffAdded": "#@@h0B@@",
    "toolDiffRemoved": "#@@h08@@",
    "toolDiffContext": "#@@h04@@",

    "syntaxComment": "#@@h03@@",
    "syntaxKeyword": "#@@h0E@@",
    "syntaxFunction": "#@@h0D@@",
    "syntaxVariable": "#@@h08@@",
    "syntaxString": "#@@h0B@@",
    "syntaxNumber": "#@@h09@@",
    "syntaxType": "#@@h0A@@",
    "syntaxOperator": "#@@h05@@",
    "syntaxPunctuation": "#@@h05@@",

    "thinkingOff": "#@@h03@@",
    "thinkingMinimal": "#@@h04@@",
    "thinkingLow": "#@@h0D@@",
    "thinkingMedium": "#@@h0C@@",
    "thinkingHigh": "#@@h0E@@",
    "thinkingXhigh": "#@@h09@@",
    "thinkingMax": "#@@h08@@",
    "bashMode": "#@@h0A@@"
  },
  "export": {
    "pageBg": "#@@h00@@",
    "cardBg": "#@@h01@@",
    "infoBg": "#@@h02@@"
  }
}
EOF
mkdir -p "$HOME/.pi/agent/themes"
cp "$out/pi-theme.json" "$HOME/.pi/agent/themes/base16.json"

# claude code ---------------------------------------------------------------
# Claude Code loads custom themes from <config dir>/themes/*.json, watches that
# directory, and picks one with `"theme": "custom:base16"` in settings.json, so
# like pi the rendered file is copied in rather than symlinked. `base` must be
# one of its two built-in palettes: overrides are layered on top of it, and any
# token it does not define is dropped, so the keys below are names from Claude's
# own 72-token palette. `text` and `inverseText` are the text drawn on top of a
# coloured accent (black on the light palette, white on the dark one) and are
# left to the base, because a base16 accent is not necessarily bright enough to
# carry a fixed foreground. Token names are Claude's; the assignments follow the
# canonical base16 mapping the other templates use, with the two colour roles
# base16 has no slot for derived rather than guessed: diff line tints blend the
# background toward base0B/base08, and the "shimmer" variants (the animated
# form of an accent) are blended toward the light foreground — base16 promises
# no brighter variant of its accents, so that is a hue shift, not a guaranteed
# brightening.
# base0F carries pink and violet, but it is the one accent base16 does not
# promise is a foreground colour ("deprecated/embedded") and plenty of the
# vendored schemes set it darker than 3:1 on the background, so it is nudged to
# 4.5:1 against base00 first, the same way accentText handles base0D.
c_mix() { "$REPO/scripts/theme-colors" --mix "$1" "$2" "$3"; }
token "cBrandShimmer"  "$(c_mix "${C[base09]}" "${C[base06]}" 0.45)"
token "cFastShimmer"   "$(c_mix "${C[base09]}" "${C[base06]}" 0.45)"
token "cAutoShimmer"   "$(c_mix "${C[base0E]}" "${C[base06]}" 0.45)"
token "cPermShimmer"   "$(c_mix "${C[base0D]}" "${C[base06]}" 0.45)"
token "cSpinShimmer"   "$(c_mix "${C[base0D]}" "${C[base06]}" 0.45)"
token "cWarnShimmer"   "$(c_mix "${C[base0A]}" "${C[base06]}" 0.45)"
token "cDiffAddBg"     "$(c_mix "${C[base00]}" "${C[base0B]}" 0.18)"
token "cDiffAddDim"    "$(c_mix "${C[base00]}" "${C[base0B]}" 0.09)"
token "cDiffDelBg"     "$(c_mix "${C[base00]}" "${C[base08]}" 0.18)"
token "cDiffDelDim"    "$(c_mix "${C[base00]}" "${C[base08]}" 0.09)"
token "cRbRedSh"       "$(c_mix "${C[base08]}" "${C[base06]}" 0.45)"
token "cRbOrangeSh"    "$(c_mix "${C[base09]}" "${C[base06]}" 0.45)"
token "cRbYellowSh"    "$(c_mix "${C[base0A]}" "${C[base06]}" 0.45)"
token "cRbGreenSh"     "$(c_mix "${C[base0B]}" "${C[base06]}" 0.45)"
token "cRbBlueSh"      "$(c_mix "${C[base0D]}" "${C[base06]}" 0.45)"
token "cRbIndigoSh"    "$(c_mix "${C[base0E]}" "${C[base06]}" 0.45)"
c_fore0F="$("$REPO/scripts/theme-colors" --ensure "${C[base0F]}" "${C[base00]}" 4.5)"
token "cFore0F"        "$c_fore0F"
token "cRbVioletSh"    "$(c_mix "$c_fore0F" "${C[base06]}" 0.45)"
render claude-theme.json <<EOF
{
  "name": "base16",
  "base": "$scheme",
  "overrides": {
    "autoAccept": "#@@h0E@@",
    "autoAcceptShimmer": "#@@cAutoShimmer@@",
    "skill": "#@@h0E@@",
    "bashBorder": "#@@h0E@@",
    "claude": "#@@h09@@",
    "claudeShimmer": "#@@cBrandShimmer@@",
    "claudeBlue_FOR_SYSTEM_SPINNER": "#@@h0D@@",
    "claudeBlueShimmer_FOR_SYSTEM_SPINNER": "#@@cSpinShimmer@@",
    "permission": "#@@h0D@@",
    "permissionShimmer": "#@@cPermShimmer@@",
    "planMode": "#@@h0C@@",
    "ide": "#@@h0D@@",
    "promptBorder": "#@@h03@@",
    "promptBorderShimmer": "#@@h04@@",
    "inactive": "#@@h04@@",
    "inactiveShimmer": "#@@h06@@",
    "subtle": "#@@h03@@",
    "suggestion": "#@@h0D@@",
    "remember": "#@@h0D@@",
    "background": "#@@h0C@@",
    "success": "#@@h0B@@",
    "error": "#@@h08@@",
    "warning": "#@@h0A@@",
    "warningShimmer": "#@@cWarnShimmer@@",
    "merged": "#@@h0E@@",
    "diffAdded": "#@@cDiffAddBg@@",
    "diffRemoved": "#@@cDiffDelBg@@",
    "diffAddedDimmed": "#@@cDiffAddDim@@",
    "diffRemovedDimmed": "#@@cDiffDelDim@@",
    "diffAddedWord": "#@@h0B@@",
    "diffRemovedWord": "#@@h08@@",
    "red_FOR_SUBAGENTS_ONLY": "#@@h08@@",
    "blue_FOR_SUBAGENTS_ONLY": "#@@h0D@@",
    "green_FOR_SUBAGENTS_ONLY": "#@@h0B@@",
    "yellow_FOR_SUBAGENTS_ONLY": "#@@h0A@@",
    "purple_FOR_SUBAGENTS_ONLY": "#@@h0E@@",
    "orange_FOR_SUBAGENTS_ONLY": "#@@h09@@",
    "pink_FOR_SUBAGENTS_ONLY": "#@@cFore0F@@",
    "cyan_FOR_SUBAGENTS_ONLY": "#@@h0C@@",
    "professionalBlue": "#@@h0D@@",
    "chromeYellow": "#@@h0A@@",
    "clawd_body": "#@@h09@@",
    "clawd_background": "#@@h00@@",
    "userMessageBackground": "#@@h01@@",
    "userMessageBackgroundHover": "#@@h02@@",
    "composerSidebarBackground": "#@@h01@@",
    "selectionBg": "#@@h02@@",
    "bashMessageBackgroundColor": "#@@h02@@",
    "memoryBackgroundColor": "#@@h02@@",
    "rate_limit_fill": "#@@h0D@@",
    "rate_limit_empty": "#@@h02@@",
    "fastMode": "#@@h09@@",
    "fastModeShimmer": "#@@cFastShimmer@@",
    "effortUltra": "#@@h0E@@",
    "briefLabelYou": "#@@h0D@@",
    "briefLabelClaude": "#@@h09@@",
    "rainbow_red": "#@@h08@@",
    "rainbow_orange": "#@@h09@@",
    "rainbow_yellow": "#@@h0A@@",
    "rainbow_green": "#@@h0B@@",
    "rainbow_blue": "#@@h0D@@",
    "rainbow_indigo": "#@@h0E@@",
    "rainbow_violet": "#@@cFore0F@@",
    "rainbow_red_shimmer": "#@@cRbRedSh@@",
    "rainbow_orange_shimmer": "#@@cRbOrangeSh@@",
    "rainbow_yellow_shimmer": "#@@cRbYellowSh@@",
    "rainbow_green_shimmer": "#@@cRbGreenSh@@",
    "rainbow_blue_shimmer": "#@@cRbBlueSh@@",
    "rainbow_indigo_shimmer": "#@@cRbIndigoSh@@",
    "rainbow_violet_shimmer": "#@@cRbVioletSh@@"
  }
}
EOF
# An unsubstituted @@token@@ would land in the file as an invalid colour and be
# dropped silently by Claude Code, so reject the render instead of installing it.
if ! jq -e '
      (.base == "dark" or .base == "light")
      and (.overrides | length > 0)
      and ([.overrides[] | test("^#([0-9a-f]{3}|[0-9a-f]{6})$")] | all)
    ' "$out/claude-theme.json" >/dev/null; then
  echo "  error: claude-theme.json failed validation (unsubstituted token?)" >&2
  exit 1
fi
for dir in "$HOME/.claude" "$HOME/.claude-healix"; do
  mkdir -p "$dir/themes"
  cp "$out/claude-theme.json" "$dir/themes/base16.json"
done


# --- wallpaper -------------------------------------------------------------
# Themes with a pinned wallpaper (the original Omarchy ports) fetch it; pure
# base16 schemes have none, so DMS keeps whatever it already has.
url=""
hash=""
[ -f "$REPO/themes/$name/backgroundurl.txt" ] &&
  url="$(tr -d '[:space:]' < "$REPO/themes/$name/backgroundurl.txt")"
[ -f "$REPO/themes/$name/backgroundsha256.txt" ] &&
  hash="$(tr -d '[:space:]' < "$REPO/themes/$name/backgroundsha256.txt")"
if [ -n "$url" ] && [ -n "$hash" ]; then
  if [ ! -s "$out/wallpaper" ]; then
    src="$(nix store prefetch-file --expected-hash "$hash" --json "$url" 2>/dev/null | jq -r .storePath || true)"
    if [ -n "$src" ] && [ -f "$src" ]; then
      cp "$src" "$out/wallpaper"
    else
      echo "  warning: could not fetch wallpaper for $name" >&2
    fi
  fi
fi

# --- live copies the compositors watch -------------------------------------
# Niri/Hyprland reload config in place, so these must change content (not just
# the symlink target) to trigger a reload.
cp "$out/niri.kdl" "$live/niri.kdl"
cp "$out/hyprland.conf" "$live/hyprland.conf"
# Read in place (not via the `current` symlink): starship/fish are sourced by
# every shell, bat/yazi read on start.
cp "$out/starship.toml" "$live/starship.toml"
cp "$out/fish.fish" "$live/fish.fish"
cp "$out/bat.tmTheme" "$live/bat.tmTheme"
cp "$out/nvim.lua" "$live/nvim.lua"
cp "$out/firefox-userChrome.css" "$live/firefox-userChrome.css"

# --- swap the current symlink ----------------------------------------------
ln -sfn "$name" "$STATE/current.tmp"
mv -Tf "$STATE/current.tmp" "$STATE/current"

echo "Rendered $name -> $out"

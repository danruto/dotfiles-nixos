inactive_tab_background #@@h01@@
inactive_tab_foreground #@@h04@@
tab_bar_background #@@h01@@
color0 #@@h00@@
color1 #@@h08@@
color2 #@@h0B@@
color3 #@@h0A@@
color4 #@@h0D@@

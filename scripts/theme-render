# Firefox / Floorp userChrome ------------------------------------------------
# firefox/floorp ---------------------------------------------------------------
# Firefox resolves its own light/dark tokens through light-dark(), which follows
# the `color-scheme` the active theme puts on :root -- on Linux that is the
# built-in System theme, so the chrome's polarity comes from the desktop
# appearance and not from CSS. scripts/theme-apply-live pins the browser's theme
# to match, and the `color-scheme` below is the belt to that pair of braces: it
# keeps the light-dark() surfaces (the vertical tab sidebar's box, the toolbox,
# scrollbars) on the palette's side of the pair even when the desktop or a
# running session still reports the previous polarity.
#
# Two of Firefox 155's selectors differ from the ones this file used to carry:
# the URL bar field is painted by `.urlbar-background` (class) rather than
# `#urlbar-background` (id), and `.tab-label` has no colour of its own -- it
# inherits `--lwt-text-color`, which is set below. Overriding `.tab-label` with a
# dimmer colour is what made inactive tab titles unreadable.
#
# The vertical tab bar is Firefox's sidebar (chrome://browser/content/sidebar),
# a separate chrome document whose surfaces come from --sidebar-* on its own
# :root, so they have to be set here rather than reached through the legacy
# #sidebar-box/#sidebar ids -- which are kept only for the bookmarks/history
# sidebar still rendered the old way.
token "ffScheme" "$scheme"
render firefox-userChrome.css <<'EOF'
/* Runtime Firefox/Floorp theme (scripts/theme-render). */
:root {
  color-scheme: @@ffScheme@@ !important;
  --sidebar-background-color: #@@h00@@ !important;
  --sidebar-box-background: #@@h01@@ !important;
  --sidebar-text-color: #@@h05@@ !important;
  --lwt-accent-color: #@@h00@@ !important;
  --lwt-text-color: #@@h05@@ !important;
  --toolbar-bgcolor: #@@h01@@ !important;
  --toolbar-color: #@@h05@@ !important;
  --toolbarbutton-icon-fill: #@@h05@@ !important;
  --toolbarbutton-hover-background: #@@h02@@ !important;
  --toolbarbutton-active-background: #@@h03@@ !important;
  --tab-selected-bgcolor: #@@h01@@ !important;
  --tab-selected-textcolor: #@@h05@@ !important;
  --tab-selected-outline-color: #@@accentText@@ !important;
  --lwt-sidebar-background-color: #@@h00@@ !important;
  --lwt-sidebar-text-color: #@@h05@@ !important;
  --urlbar-box-bgcolor: #@@h02@@ !important;
  --urlbar-box-text-color: #@@vicSelFg@@ !important;
  --urlbar-popup-url-color: #@@accentText@@ !important;
  --focus-outline-color: #@@accentText@@ !important;
  --toolbar-field-background-color: #@@h02@@ !important;
  --toolbar-field-color: #@@vicSelFg@@ !important;
  --toolbar-field-border-color: #@@h03@@ !important;
  --toolbar-field-border-color-focus: #@@accentText@@ !important;
  --link-color: #@@accentText@@ !important;
  --link-color-hover: #@@accentText@@ !important;
  --link-color-active: #@@accentText@@ !important;
  --button-primary-bgcolor: #@@h0D@@ !important;
  --button-primary-color: #@@onAccent@@ !important;
}
#navigator-toolbox, #TabsToolbar, #nav-bar, #PersonalToolbar {
  background-color: #@@h00@@ !important;
  color: #@@h05@@ !important;
}
.urlbar-background {
  background-color: #@@h02@@ !important;
  border-color: #@@h03@@ !important;
}
#urlbar-input, .urlbar-input-box, #searchbar {
  color: #@@vicSelFg@@ !important;
}
/* Firefox paints the URL bar placeholder at roughly 55% opacity, which lands
   under 4.5:1 on the field in both polarities (2.1:1 on ayu-light, 3.8:1 on
   dracula). WCAG counts placeholder text as text, and the palette leaves no room
   for a dimmer grey that still clears 4.5:1 on the field, so it is forced to the
   muted colour at full opacity. */
#urlbar-input::placeholder, #searchbar::placeholder {
  color: #@@vicMuted@@ !important;
  opacity: 1 !important;
}
.tabbrowser-tab[selected] > .tab-stack > .tab-background {
  background-color: #@@h01@@ !important;
}
#sidebar-box, #sidebar { background-color: #@@h00@@ !important; }
EOF


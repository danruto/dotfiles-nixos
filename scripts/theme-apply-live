#!/usr/bin/env bash
# Live-apply the current theme to the running session. No logout needed.
# Called automatically by scripts/theme-set; safe to run on its own.
#
# What it covers:
#   niri      - live-reloads config.kdl on save by itself, nothing to do
#   hyprland  - `hyprctl reload` when running
#   dms       - restarted (bar flickers ~1s, windows untouched)
#   foot/kitty- SIGUSR1 reloads config in running windows
#   ghostty   - SIGUSR2 reloads config in running windows
#   herdr     - `herdr server reload-config` when a server is running
#   pi        - watches ~/.pi/agent/themes/, reloads the active theme in place
#   claude    - watches ~/.claude/themes/, reloads the active theme in place
#   fish/starship - picked up by new processes/prompts
#
# Still needs a manual restart: browser, btop, gitui, vscode, helix, GTK apps.
set -u

RUNTIME="/run/user/$(id -u)"
if [ -d "$RUNTIME" ]; then
  export XDG_RUNTIME_DIR="$RUNTIME"
fi
export PATH="/etc/profiles/per-user/$(id -un)/bin:$HOME/.local/bin:$PATH"

say() { echo "  $1"; }

# Compositor configs. Niri live-reloads on file write; Hyprland needs a nudge.
if pgrep -x Hyprland >/dev/null 2>&1; then
  sig_dir="$(ls -td "$RUNTIME"/hypr/* 2>/dev/null | head -1 || true)"
  if [ -n "$sig_dir" ]; then
    export HYPRLAND_INSTANCE_SIGNATURE="$(basename "$sig_dir")"
    if hyprctl reload >/dev/null 2>&1; then
      say "hyprland reloaded"
    else
      say "hyprland running but reload failed (re-login for borders)"
    fi
  fi
elif pgrep -x niri >/dev/null 2>&1; then
  say "niri live-reloaded config on switch"
else
  say "no compositor running, nothing to reload"
fi

# DMS owns bar/launcher/notifications/polkit: restart to pick up new settings.
if pgrep -f "[d]ms run" >/dev/null 2>&1; then
  pkill -f "[d]ms run" 2>/dev/null || true
  sleep 1
  if pgrep -f "[d]ms run" >/dev/null 2>&1; then
    pkill -9 -f "[d]ms run" 2>/dev/null || true
    sleep 1
  fi
  setsid dms run >/dev/null 2>&1 < /dev/null &
  sleep 2
  if pgrep -f "[d]ms run" >/dev/null 2>&1; then
    say "dms restarted"
  else
    echo "  DMS FAILED to restart. Run 'dms run' from a terminal, or re-login."
  fi
fi

# Terminals that reload config without restarting.
for term in foot kitty; do
  if pgrep -x "$term" >/dev/null 2>&1; then
    pkill -SIGUSR1 -x "$term" 2>/dev/null || true
    say "$term reloaded"
  fi
done

# Ghostty reloads its config on SIGUSR2. The Nix wrapper execs .ghostty-wrapped,
# so the process comm is ".ghostty-wrappe", not "ghostty" -- match on the exe.
for pid in $(pgrep -f 'bin/ghostty' 2>/dev/null || true); do
  exe="$(readlink "/proc/$pid/exe" 2>/dev/null || true)"
  case "$exe" in
    *ghostty*)
      kill -USR2 "$pid" 2>/dev/null && say "ghostty reloaded"
      ;;
  esac
done

# bat compiles its themes into a cache; rebuild it after the theme file changes.
if command -v bat >/dev/null 2>&1; then
  bat cache --build >/dev/null 2>&1 && say "bat cache rebuilt" || true
fi

# herdr reads the palette from its config.toml (rendered into a marker block by
# scripts/theme-render) and reloads it over the socket API. SIGUSR2 is ghostty's
# signal, not herdr's, so it needs an explicit nudge.
if command -v herdr >/dev/null 2>&1 &&
  herdr status server 2>/dev/null | grep -q '^status: running'; then
  if herdr server reload-config >/dev/null 2>&1; then
    say "herdr reloaded"
  else
    say "herdr running but reload failed"
  fi
fi

# libadwaita/GNOME apps (Nautilus, ...) only accept a named accent + scheme.
if command -v gsettings >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  state="${XDG_STATE_HOME:-$HOME/.local/state}/theme"
  if [ -r "$state/current/palette.json" ]; then
    if gsettings set org.gnome.desktop.interface accent-color \
      "$(jq -r .accentName "$state/current/palette.json")" 2>/dev/null; then
      say "libadwaita accent set ($(jq -r .accentName "$state/current/palette.json"))"
    fi
    if [ "$(jq -r .polarity "$state/current/palette.json")" = "light" ]; then
      gsettings set org.gnome.desktop.interface color-scheme "prefer-light" 2>/dev/null || true
    else
      gsettings set org.gnome.desktop.interface color-scheme "prefer-dark" 2>/dev/null || true
    fi
  fi
fi

# Helium / Chromium-family: write the theme colour as a managed policy (the
# same mechanism Omarchy uses) and refresh running browsers without a restart.
if command -v helium >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  state="${XDG_STATE_HOME:-$HOME/.local/state}/theme"
  if [ -r "$state/current/palette.json" ]; then
    hex="$(jq -r .base00 "$state/current/palette.json")"
    if [ "$(jq -r .polarity "$state/current/palette.json")" = "light" ]; then
      scheme=light
    else
      scheme=dark
    fi
    if sudo -n true 2>/dev/null; then
      sudo -n mkdir -p /etc/chromium/policies/managed
      printf '{"BrowserThemeColor":"#%s","BrowserColorScheme":"%s"}\n' "$hex" "$scheme" \
        | sudo -n tee /etc/chromium/policies/managed/color.json >/dev/null
      say "helium policy written"
      if pgrep -x helium >/dev/null 2>&1; then
        helium --refresh-platform-policy --no-startup-window >/dev/null 2>&1 || true
        say "helium refreshed"
      fi
    else
      say "helium: needs passwordless sudo for /etc/chromium/policies (skipped)"
    fi
  fi
fi

# Floorp/Firefox profiles are user-writable, so drop the generated userChrome in
# and pin the browser's own polarity. Both are read at browser start, so a switch
# needs a restart.
#
# `extensions.activeThemeID` is the lever that actually works. Under the built-in
# System theme the chrome's polarity comes from the desktop appearance, which
# Gecko reads from GTK at startup and *caches* into prefs.js as
# `ui.systemUsesDarkTheme` -- so writing that pref, as this block used to, does
# not move the browser: it is what Gecko derives from GTK, and it was left at 0
# (light) under a dark palette. Selecting the matching built-in theme instead
# makes light-dark() resolve on the palette's side and decides the "website
# appearance" setting with it, with no dependency on GTK or the portal. That
# pref is still written so the cache content processes read does not contradict
# the theme until Gecko rewrites it.
dark=1
theme_id="firefox-compact-dark@mozilla.org"
[ "$(jq -r .polarity "$state/current/palette.json")" = "light" ] && dark=0
[ "$dark" = 0 ] && theme_id="firefox-compact-light@mozilla.org"
for prof in "$HOME"/.floorp/*/ "$HOME"/.mozilla/firefox/*/; do
  [ -d "$prof" ] || continue
  [ -f "$prof/prefs.js" ] || [ -f "$prof/times.json" ] || continue
  mkdir -p "$prof/chrome"
  cp "$state/live/firefox-userChrome.css" "$prof/chrome/userChrome.css"
  ujs="$prof/user.js"
  tmp="$(mktemp)"
  {
    echo '// >>> theme (generated by scripts/theme-apply-live; edit outside the markers)'
    echo 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);'
    echo "user_pref(\"ui.systemUsesDarkTheme\", $dark);"
    echo "user_pref(\"extensions.activeThemeID\", \"$theme_id\");"
    echo '// <<< theme'
  } > "$tmp"
  if [ -f "$ujs" ] && grep -q '^// >>> theme' "$ujs"; then
    block="$(cat "$tmp")"
    awk -v block="$block" '
      /^\/\/ >>> theme/ { print block; skip = 1; next }
      /^\/\/ <<< theme/ { skip = 0; next }
      !skip
    ' "$ujs" > "$ujs.tmp" && mv "$ujs.tmp" "$ujs"
  else
    cat "$tmp" >> "$ujs"
  fi
  rm -f "$tmp"
  say "floorp/firefox profile $(basename "$prof") themed (restart browser)"
done

echo "Live apply done. Restart running GUI apps (browser, editor) for full effect."
